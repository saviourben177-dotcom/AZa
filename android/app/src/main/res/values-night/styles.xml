<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme (night). -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!--
      Explicit night override for the launch/splash theme.
      Without this file, Android may resolve @drawable/splash on the base
      (light) theme before the night-qualified drawable folders are
      considered, causing the splash to show the light variant even in
      dark mode. Declaring the style here forces correct per-mode
      resolution alongside the drawable-*-night-* qualified assets.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
